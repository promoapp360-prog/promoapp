{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:payments": "node scripts/verify-payments.mjs",
    "test:finance": "node scripts/verify-finance.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.12",
    "@clerk/shared": "^4.9.0",
    "@google-cloud/storage": "^7.22.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "pdfkit": "^0.21.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.0",
    "stripe": "20.0.0",
    "stripe-replit-sync": "1.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0"
  }
